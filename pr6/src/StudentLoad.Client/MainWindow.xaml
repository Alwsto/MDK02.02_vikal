<Window x:Class="StudentLoad.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление студенческой нагрузкой" Height="620" Width="1050"
        MinHeight="480" MinWidth="780" Background="#F4F6F9">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock Text="Учебная нагрузка" FontSize="28" FontWeight="SemiBold" Foreground="#18324B"/>
      <TextBlock Text="Расчёт по преподавателям · учебный год 2026–2027" Margin="0,5,0,0" Foreground="#64748B" FontSize="14"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Обновить" Command="{Binding RefreshCommand}" Background="#245A8D" Foreground="White" BorderThickness="0"/>
          <Button Content="Демо-данные" Command="{Binding DemoCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Поиск преподавателя" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox Width="280" HorizontalAlignment="Left" Padding="8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="#E8F0F7" CornerRadius="6" Padding="10" Margin="0,0,0,12">
      <DockPanel>
        <ProgressBar Width="110" Height="8" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" DockPanel.Dock="Right"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#29445E"/>
      </DockPanel>
    </Border>
    <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredItems}" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="White" BorderBrush="#DCE3EA" RowHeight="42" ColumnHeaderHeight="42">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
        <DataGridTextColumn Header="Подразделение" Binding="{Binding Department}" Width="*"/>
        <DataGridTextColumn Header="Учебный год" Binding="{Binding AcademicYear}" Width="110"/>
        <DataGridTextColumn Header="План, ч" Binding="{Binding PlannedHours}" Width="90"/>
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" Text="{Binding FooterMessage}" Margin="0,12,0,0" Foreground="#64748B"/>
  </Grid>
</Window>
