{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/error-response.schema.json",
  "title": "ErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "error"],
  "properties": {
    "success": { "const": false },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "traceId"],
      "properties": {
        "code": {
          "enum": ["VALIDATION_ERROR", "AUTH_INVALID_CREDENTIALS", "AUTH_CLIENT_INVALID", "AUTH_RATE_LIMITED", "INTERNAL_ERROR"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
